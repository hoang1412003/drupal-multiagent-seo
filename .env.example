ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DRUPAL_BASE_URL=http://drupal.ddev.site
DRUPAL_USER=
DRUPAL_PASSWORD=

# Kho vector (Postgres + pgvector). De trong thi dung mac dinh khop
# multiagent/docker-compose.yml, tuc chay duoc ngay sau `docker compose up -d`.
PG_DSN=postgresql://vf_agent:vf_agent@127.0.0.1:5433/vf_agent

# Token dung chung giua Drupal va service Multi-Agent (spec 2026-08-07 muc 8).
# Sinh bang: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Phia Drupal dat cung gia tri nay vao $settings['vf_ai_service_token'] trong
# settings.php - KHONG dat vao config entity, vi config export ra YAML la lo
# secret vao git.
VF_SERVICE_TOKEN=
VF_API_PORT=8900

# Platform Admin: sinh HAI gia tri rieng, moi gia tri bang lenh:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Khong dung lai VF_SERVICE_TOKEN va khong dung cung mot key cho hai dong.
ADMIN_CSRF_KEY=
ADMIN_THROTTLE_KEY=

# Local HTTP de false; production bat buoc HTTPS va dat true.
ADMIN_COOKIE_SECURE=false
