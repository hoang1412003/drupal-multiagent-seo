.env
__pycache__/
*.pyc
.venv/
venv/
~$*.docx

# KB fact-check Chroma sinh ra tu src/kb/build_kb.py - build lai duoc tu specs.json
multiagent/src/kb/chroma/

# Project Drupal dựng bằng DDEV. Chỉ commit những gì cần để tái lập môi trường
# (composer.json/lock ghim phiên bản, .ddev cấu hình, script tạo field);
# phần tải về/sinh ra (web/, vendor/) không commit.
drupal/*
!drupal/.ddev/
!drupal/composer.json
!drupal/composer.lock
!drupal/scripts/

# Module tự viết (vf_ai_review) là code của dự án, KHÔNG phải thứ composer
# tải về, nên phải commit. Git không cho un-ignore một file khi thư mục cha
# còn bị ignore, vì vậy phải mở lại từng cấp rồi chặn lại phần còn lại -
# web/core, web/sites, các module contrib... vẫn nằm ngoài repo như cũ.
!drupal/web/
drupal/web/*
!drupal/web/modules/
drupal/web/modules/*
!drupal/web/modules/custom/
