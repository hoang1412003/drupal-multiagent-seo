<?php

/**
 * @file
 * Hiển thị kết quả đánh giá Multi-Agent AI trong giao diện soạn bài.
 *
 * Module CHỈ ĐỌC: không tính điểm, không gọi API, không sửa dữ liệu node.
 * Hỏng thì cùng lắm không thấy báo cáo, không thể làm sai dữ liệu đánh giá.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\vf_ai_review\AiInputFingerprint;
use Drupal\vf_ai_review\AiReportRenderer;

/**
 * Bốn field do hệ Multi-Agent ghi vào, người soạn không được sửa.
 */
const VF_AI_REVIEW_FIELDS = [
  'field_ai_status',
  'field_ai_score',
  'field_ai_suggestions',
  'field_ai_report_json',
];

/**
 * Ánh xạ khoá field trong báo cáo -> tên phần tử trên form soạn bài.
 *
 * Để MỘT CHỖ DUY NHẤT. Tên nào không tồn tại trên form thì bỏ qua field đó
 * chứ không đổ lỗi - sai một tên không được làm trắng trang form soạn bài
 * (docs/editor-ui-design.md mục 8).
 *
 * `body` và `summary` cùng trỏ về widget 'body' vì summary là teaser nằm
 * trong chính widget đó - chú thích của hai khoá này được ghép lại.
 */
const VF_AI_REVIEW_FIELD_MAP = [
  'title' => 'title',
  'body' => 'body',
  'summary' => 'body',
  'meta_description' => 'field_meta_description',
  'url_alias' => 'path',
  'image_alt' => 'field_image',
];

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * Tên hàm CHÍNH LÀ phần khai báo: Drupal thấy hàm tên
 * <ten_module>_form_node_form_alter thì tự gọi mỗi khi dựng form node.
 * Dấu & trước $form nghĩa là sửa trực tiếp vào mảng gốc.
 */
function vf_ai_review_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'article') {
    return;
  }

  // Ẩn hẳn 4 field AI. Dùng #access = FALSE chứ KHÔNG dùng
  // '#attributes' => ['readonly' => 'readonly'] - cái đó chỉ là thuộc tính
  // HTML, chặn ở trình duyệt nhưng người dùng vẫn gửi giá trị lên server.
  foreach (VF_AI_REVIEW_FIELDS as $ten) {
    if (isset($form[$ten])) {
      $form[$ten]['#access'] = FALSE;
    }
  }

  $renderer = new AiReportRenderer();
  $tho = _vf_ai_review_gia_tri($node, 'field_ai_report_json');
  $report = $renderer->decode($tho);
  // Có dữ liệu nhưng giải mã không được -> trạng thái "JSON hỏng", khác hẳn
  // "chưa chấm" (field trống). Phải phân biệt để lỗi dữ liệu không bị hiểu
  // nhầm thành tình trạng bình thường.
  $loi_json = ($tho !== '' && $report === NULL);

  // So hash để biết bài có bị sửa sau khi chấm không. Dùng hash chứ KHÔNG
  // dùng mốc `changed` của node: chính lệnh PATCH của write_back() làm mốc
  // đó nhảy, nên so nó sẽ luôn báo "đã thay đổi" ngay sau khi chấm.
  //
  // Phải chọn thuật toán theo ĐÚNG phiên bản ghi trong chính báo cáo. Báo cáo
  // cũ (không có khoá version, hoặc version 1) được băm bằng bốn field; đem
  // fingerprint v2 sáu field ra so với nó thì bài nào cũng bị báo "đã thay
  // đổi". Ngược lại cũng vậy. Hai đường phải cùng sống suốt cửa sổ rollback.
  $stale = FALSE;
  if ($report !== NULL && !empty($report['content_hash'])) {
    $phien_ban = (int) ($report['content_hash_version'] ?? 1);
    $hien_tai = $phien_ban === AiInputFingerprint::VERSION
      ? AiInputFingerprint::hash(vf_ai_review_input_fields($node))
      : AiReportRenderer::contentHash(vf_ai_review_hash_fields($node));
    $stale = ($hien_tai !== $report['content_hash']);
  }

  $form['vf_ai_review'] = [
    '#type' => 'details',
    '#title' => 'Đánh giá AI',
    '#group' => 'advanced',
    '#open' => TRUE,
    '#weight' => -10,
    'noi_dung' => [
      // Chuỗi này đã được AiReportRenderer escape toàn bộ phần động.
      //
      // CHỈ phần băng không có (phân rã theo field). Băng ở đầu form đã hiện
      // đề xuất/điểm/giờ chấm/tổng số vấn đề rồi; lặp lại ở đây là hai chỗ
      // nói một điều trên cùng màn hình. `overviewHtml()` vẫn còn làm đường
      // lùi nếu cần quay lại bản cũ.
      '#markup' => $renderer->tomTatHtml($report),
    ],
  ];

  // Băng trạng thái sticky ở ĐẦU form (editor-ui-design.md mục 10).
  // '#weight' rất âm để nó nằm trên mọi field; nó phải luôn nhìn thấy được
  // khi cuộn, nếu không thì nút Trước/Sau và dòng đếm lỗi chặn xuất bản
  // trôi mất khỏi màn hình đúng lúc người dùng đang cần.
  $trang_thai = $renderer->trangThai($report, $stale, $loi_json);
  $form['vf_ai_band'] = [
    '#markup' => $renderer->bangHtml($report, $trang_thai),
    '#weight' => -999,
  ];

  // Gom chú thích theo widget đích TRƯỚC, vì body và summary cùng trỏ về
  // widget 'body' - gắn thẳng thì cái sau đè mất cái trước.
  $theo_widget = [];
  foreach (VF_AI_REVIEW_FIELD_MAP as $khoa_bao_cao => $ten_form) {
    $html = $renderer->theLoiHtml($report, $khoa_bao_cao);
    if ($html !== '') {
      $theo_widget[$ten_form] = ($theo_widget[$ten_form] ?? '') . $html;
    }
  }

  foreach ($theo_widget as $ten_form => $html) {
    if (isset($form[$ten_form])) {
      $form[$ten_form]['#suffix'] = ($form[$ten_form]['#suffix'] ?? '') . $html;
    }
  }

  // Khoá localStorage cho dấu "đã xử lý" (mục 10.4). PHẢI gồm content_hash:
  // bài được chấm lại thì hash đổi -> dấu cũ tự hết hiệu lực. Chỉ khoá theo
  // nid thì dấu của lỗi CŨ dính trên báo cáo MỚI và người duyệt tưởng đã
  // xử lý rồi - đúng loại lỗi im lặng mà mục 4.4 đã phải xử lý một lần.
  $form['#attached']['drupalSettings']['vfAiReview'] = [
    'nid' => (string) ($node->id() ?? 'moi'),
    'hash' => (string) ($report['content_hash'] ?? ''),
    'trangThai' => $trang_thai,
  ];
  $form['#attached']['library'][] = 'vf_ai_review/report';
}

/**
 * Đọc giá trị một field của node, trả chuỗi rỗng nếu không có.
 *
 * Đọc phòng thủ giống fetch_content() bên Python: field chưa cấu hình hoặc
 * để trống thì trả rỗng, không làm sập form soạn bài.
 */
function _vf_ai_review_gia_tri($node, string $ten_field, string $thuoc_tinh = 'value'): string {
  if (!$node->hasField($ten_field) || $node->get($ten_field)->isEmpty()) {
    return '';
  }
  return (string) ($node->get($ten_field)->{$thuoc_tinh} ?? '');
}

/**
 * Bốn field tham gia content_hash, lấy ra khỏi node.
 *
 * Để một chỗ duy nhất vì từ 2026-08-07 có hai nơi cần: khối báo cáo (băng
 * "nội dung đã thay đổi") và module vf_ai_trigger (tính hash gửi kèm job).
 * Hai nơi ghép khác nhau nghĩa là hash lệch, và hệ quả là vòng đối soát
 * chấm lại vô hạn mọi bài.
 *
 * KHÔNG đưa vào AiReportRenderer: class đó cố ý không phụ thuộc Drupal để
 * test được bằng PHP thuần.
 */
function vf_ai_review_hash_fields($node): array {
  return [
    'title' => (string) $node->label(),
    'body' => _vf_ai_review_gia_tri($node, 'body'),
    'summary' => _vf_ai_review_gia_tri($node, 'body', 'summary'),
    'meta_description' => _vf_ai_review_gia_tri($node, 'field_meta_description'),
  ];
}

/**
 * SÁU input của fingerprint v2, lấy ra khỏi node.
 *
 * Khác vf_ai_review_hash_fields() (v1, bốn field) ở chỗ có thêm `url_alias`
 * và `image_alt` - hai thứ SEO Agent thực sự chấm nhưng v1 bỏ sót (nợ N2).
 *
 * Phải đọc y hệt cách _fields_tu_resource() bên Python đọc JSON:API, nếu
 * không hai bên ra hai hash khác nhau và vòng đối soát chấm lại vô hạn.
 */
function vf_ai_review_input_fields($node): array {
  $body = _vf_ai_review_gia_tri($node, 'body');
  return [
    'title' => (string) $node->label(),
    'body' => $body,
    'summary' => _vf_ai_review_gia_tri($node, 'body', 'summary'),
    'url_alias' => _vf_ai_review_url_alias($node),
    'meta_description' => _vf_ai_review_gia_tri($node, 'field_meta_description'),
    'image_alt' => AiInputFingerprint::imageAltLines(
      _vf_ai_review_alt_anh_dai_dien($node),
      $body
    ),
  ];
}

/**
 * URL alias của node, hoặc chuỗi rỗng nếu chưa có alias.
 *
 * JSON:API trả `path.alias` = "" khi không có alias, còn service của Drupal
 * trả lại chính đường hệ thống (/node/12). Quy về cùng một biểu diễn ở đây,
 * nếu không hai bên lệch hash trên đúng những bài chưa đặt alias.
 */
function _vf_ai_review_url_alias($node): string {
  if ($node->isNew() || !$node->id()) {
    return '';
  }
  $duong_he_thong = '/node/' . $node->id();
  $alias = \Drupal::service('path_alias.manager')
    ->getAliasByPath($duong_he_thong, $node->language()->getId());
  return $alias === $duong_he_thong ? '' : $alias;
}

/**
 * Alt của ảnh đại diện; NULL nghĩa là bài không có ảnh đại diện.
 *
 * Phân biệt NULL với chuỗi rỗng là có chủ đích: NULL -> không sinh dòng nào,
 * chuỗi rỗng -> có ảnh nhưng THIẾU alt (vẫn phải sinh dòng để lỗi B6 nhìn
 * thấy được). Khớp cách Python đọc relationships.field_image.data.
 */
function _vf_ai_review_alt_anh_dai_dien($node): ?string {
  if (!$node->hasField('field_image') || $node->get('field_image')->isEmpty()) {
    return NULL;
  }
  return (string) ($node->get('field_image')->alt ?? '');
}
