{#
/**
 * @file
 * Theme override for the VinFast Blog listing front page.
 */
#}
<div class="flex flex-col min-h-screen">
  <!-- Top Navigation Bar -->
  <header class="fixed top-0 left-0 w-full z-50 bg-surface-white/80 dark:bg-surface-dim/80 backdrop-blur-xl border-b border-outline-variant/30 shadow-sm transition-all duration-300 ease-in-out">
    <div class="flex justify-between items-center h-20 max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop">
      <a class="font-headline-lg text-headline-lg font-bold text-primary dark:text-primary-fixed tracking-tight hover:opacity-90 transition-opacity" href="{{ path('<front>') }}">
        VinFast
      </a>
      
      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-6">
        <a class="font-body-md text-primary font-semibold border-b-2 border-primary pb-1 px-3 py-2" href="{{ path('<front>') }}">
          Tin tức & Blog
        </a>
      </nav>

      <!-- Top Right Actions -->
      <div class="flex items-center space-x-3">
        <button aria-label="Tìm kiếm" class="text-primary hover:text-primary-container transition-colors p-2 rounded-full hover:bg-surface-container">
          <span class="material-symbols-outlined align-middle" style="font-variation-settings: 'FILL' 0;">search</span>
        </button>

        {% if logged_in %}
          <div class="hidden md:flex items-center space-x-2 bg-surface-container px-3 py-1.5 rounded-full border border-outline-variant/30">
            <span class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs">
              {{ user_name|first|upper }}
            </span>
            <span class="font-body-md text-xs font-semibold text-primary max-w-[100px] truncate">{{ user_name }}</span>
            <a href="{{ user_logout_url|default('/user/logout') }}" class="text-xs text-secondary hover:text-error ml-1 transition-colors" title="Đăng xuất">
              <span class="material-symbols-outlined text-base align-middle">logout</span>
            </a>
          </div>
        {% else %}
          <a class="hidden md:inline-flex items-center justify-center px-6 py-2 bg-primary text-on-primary font-label-md text-label-md rounded-full hover:shadow-[0_0_15px_rgba(0,85,255,0.25)] transition-all" href="/user/login">
            Đăng nhập
          </a>
        {% endif %}

        <!-- Mobile Menu Toggle Button -->
        <button data-vf-mobile-menu-btn class="md:hidden text-primary p-2 focus:outline-none" aria-label="Menu">
          <span class="material-symbols-outlined align-middle text-2xl">menu</span>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div data-vf-mobile-menu class="hidden md:hidden bg-surface-white border-b border-outline-variant/30 px-6 py-4 space-y-3 shadow-lg">
      <a class="block py-2 font-body-md text-primary font-semibold" href="{{ path('<front>') }}">Tin tức & Blog</a>
      {% if logged_in %}
        <div class="pt-2 border-t border-outline-variant/30 space-y-2">
          <a class="block text-center py-2 bg-outline-variant/30 text-secondary font-label-md rounded-full" href="{{ user_logout_url|default('/user/logout') }}">Đăng xuất ({{ user_name }})</a>
        </div>
      {% else %}
        <div class="pt-2 border-t border-outline-variant/30">
          <a class="block text-center py-2 bg-primary text-on-primary font-label-md rounded-full" href="/user/login">Đăng nhập</a>
        </div>
      {% endif %}
    </div>
  </header>

  <!-- Main Content Canvas -->
  <main class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-8 md:py-12">
    <!-- Hero Section -->
    {% if vf_hero_article %}
      <section class="mb-16">
        <div class="relative w-full h-[460px] md:h-[580px] rounded-2xl overflow-hidden group shadow-lg">
          {% if vf_hero_article.image %}
          <img
            alt="{{ vf_hero_article.title }}"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            src="{{ vf_hero_article.image }}"
          />
          {% endif %}
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent flex flex-col justify-end p-6 md:p-12">
            <div class="mb-3">
              <span class="inline-block bg-white/20 backdrop-blur-md text-white font-label-sm text-label-sm uppercase tracking-wider px-3.5 py-1 rounded-full border border-white/30">
                {{ vf_hero_article.category|default('Khám Phá') }}
              </span>
            </div>
            <h1 class="font-display-lg text-3xl md:text-5xl lg:text-6xl text-white font-bold mb-4 max-w-3xl leading-tight">
              <a href="{{ vf_hero_article.url }}" class="hover:underline">
                {{ vf_hero_article.title }}
              </a>
            </h1>
            <p class="font-body-lg text-surface-container-high text-base md:text-lg max-w-2xl mb-6 line-clamp-2">
              {{ vf_hero_article.summary }}
            </p>
            <div>
              <a class="inline-flex items-center space-x-2 text-white font-label-md text-label-md uppercase tracking-widest group/btn bg-white/10 hover:bg-white/20 px-5 py-2.5 rounded-full backdrop-blur-sm border border-white/30 transition-all" href="{{ vf_hero_article.url }}">
                <span>Đọc tiếp</span>
                <span class="material-symbols-outlined transition-transform group-hover/btn:translate-x-1" style="font-variation-settings: 'FILL' 0;">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>
      </section>
    {% endif %}

    <!-- Filter & Search Bar -->
    <section class="mb-12 sticky top-24 z-40" data-vf-filter-bar>
      <div class="glass-panel rounded-2xl md:rounded-full px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4 shadow-md">
        <!-- Category Filter Chips -->
        <div class="flex items-center space-x-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 scrollbar-hide">
          <button data-vf-filter-chip data-category="all" class="whitespace-nowrap px-5 py-2 rounded-full bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-wider transition-all shadow-sm">
            Tất cả
          </button>
          {% for tag_name in vf_tags_filter %}
            <button data-vf-filter-chip data-category="{{ tag_name }}" class="whitespace-nowrap px-5 py-2 rounded-full bg-surface-container hover:bg-surface-variant text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider transition-all">
              {{ tag_name }}
            </button>
          {% endfor %}
        </div>

        <!-- Search Input -->
        <div class="relative w-full md:w-72">
          <input
            data-vf-search-input
            class="w-full bg-surface-container-lowest border border-outline-variant/60 rounded-full py-2.5 pl-4 pr-10 font-body-md text-sm text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all shadow-inner"
            placeholder="Tìm kiếm bài viết..."
            type="text"
          />
          <span class="material-symbols-outlined absolute right-3.5 top-1/2 -translate-y-1/2 text-on-surface-variant" style="font-variation-settings: 'FILL' 0;">search</span>
        </div>
      </div>
    </section>

    <!-- Blog Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter" id="vf-blog-grid">
      {% for article in vf_blog_articles %}
        <article
          data-vf-blog-card
          data-category="{{ article.category }}"
          data-tags="{{ article.tags|join(' ') }}"
          class="card-container flex flex-col bg-surface-container-lowest border border-outline-variant/40 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
        >
          <!-- Card Image Container -->
          <div class="relative h-64 overflow-hidden bg-surface-container">
            <a href="{{ article.url }}" class="block w-full h-full">
              {# Bài chưa có ảnh thì để ô màu nền, không mượn ảnh của bài khác #}
              {% if article.image %}
              <img
                alt="{{ article.title }}"
                class="w-full h-full object-cover card-hover-image"
                src="{{ article.image }}"
                loading="lazy"
              />
              {% endif %}
            </a>
            <div class="absolute top-4 left-4">
              <span class="bg-surface-white/95 backdrop-blur-md text-primary font-label-sm text-label-sm font-semibold uppercase px-3 py-1 rounded-md shadow-sm border border-outline-variant/30">
                {{ article.category }}
              </span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-6 flex-1 flex flex-col">
            <h3 data-vf-card-title class="font-headline-lg text-xl md:text-2xl font-bold text-on-surface mb-3 line-clamp-2 hover:text-primary transition-colors">
              <a href="{{ article.url }}">
                {{ article.title }}
              </a>
            </h3>
            <p data-vf-card-summary class="font-body-md text-on-surface-variant mb-6 line-clamp-3 flex-1 text-sm md:text-base leading-relaxed">
              {{ article.summary }}
            </p>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-outline-variant/30">
              <span class="font-label-sm text-label-sm text-secondary font-medium">{{ article.date }}</span>
              <a class="text-primary hover:text-primary-container p-1 rounded-full hover:bg-surface-container transition-colors" href="{{ article.url }}" aria-label="Xem chi tiết">
                <span class="material-symbols-outlined align-middle" style="font-variation-settings: 'FILL' 0;">arrow_outward</span>
              </a>
            </div>
          </div>
        </article>
      {% else %}
        <!-- Fallback if no articles found -->
        <div class="col-span-full py-12 text-center text-on-surface-variant">
          <p>Hiện chưa có bài viết nào được đăng tải.</p>
        </div>
      {% endfor %}
    </section>

    <!-- Empty Results Message -->
    <div id="vf-empty-results" class="hidden py-16 text-center">
      <span class="material-symbols-outlined text-5xl text-outline mb-3 block">sentiment_dissatisfied</span>
      <h3 class="font-headline-lg text-xl font-bold text-on-surface mb-2">Không tìm thấy bài viết phù hợp</h3>
      <p class="font-body-md text-on-surface-variant">Vui lòng thử tìm kiếm với từ khóa khác hoặc chọn danh mục khác.</p>
    </div>

    <!-- Load More -->
    {% if vf_blog_articles|length >= 6 %}
      <div class="mt-16 flex justify-center">
        <button
          data-vf-load-more
          class="px-8 py-3.5 bg-transparent border-2 border-primary/40 text-primary font-label-md text-label-md uppercase tracking-wider rounded-full hover:bg-primary hover:text-white hover:border-primary transition-all duration-300 shadow-sm"
        >
          Tải thêm bài viết
        </button>
      </div>
    {% endif %}
  </main>

  <!-- Footer -->
  <footer class="w-full py-section-gap mt-section-gap bg-surface-container-highest dark:bg-surface-dim border-t border-outline-variant/50 transition-all duration-200">
    <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-4 gap-gutter">
      <div class="col-span-1 md:col-span-1 flex flex-col mb-8 md:mb-0">
        <span class="font-headline-lg text-headline-lg font-bold text-primary dark:text-primary-fixed mb-4">VinFast</span>
        <p class="font-body-md text-secondary dark:text-on-secondary-fixed-variant">
          © {{ 'now'|date('Y') }} VinFast Vietnam. Đã đăng ký bản quyền.
        </p>
      </div>
      <div class="col-span-1 md:col-span-3 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col space-y-3">
          <h4 class="font-body-md font-semibold text-on-surface mb-2">Về VinFast</h4>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Về chúng tôi</a>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Phát triển bền vững</a>
        </div>
        <div class="flex flex-col space-y-3">
          <h4 class="font-body-md font-semibold text-on-surface mb-2">Thông tin</h4>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Nhà đầu tư</a>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Liên hệ</a>
        </div>
        <div class="flex flex-col space-y-3">
          <h4 class="font-body-md font-semibold text-on-surface mb-2">Pháp lý</h4>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Chính sách bảo mật</a>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Điều khoản dịch vụ</a>
        </div>
      </div>
    </div>
  </footer>
</div>
