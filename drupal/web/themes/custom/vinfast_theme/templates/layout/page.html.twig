{#
/**
 * @file
 * Theme override to display a single page.
 */
#}
<div class="flex flex-col min-h-screen">
  <!-- Top Navigation Bar -->
  <header class="fixed top-0 left-0 w-full z-50 bg-surface-white/80 dark:bg-surface-dim/80 backdrop-blur-xl border-b border-outline-variant/30 shadow-sm transition-all duration-300 ease-in-out">
    <div class="flex justify-between items-center h-20 max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop">
      <a class="font-headline-lg text-headline-lg font-bold text-primary dark:text-primary-fixed tracking-tight hover:opacity-90 transition-opacity" href="{{ path('<front>') }}">
        VinFast
      </a>
      
      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-6">
        <a class="font-body-md text-primary font-semibold border-b-2 border-primary pb-1 px-3 py-2" href="{{ path('<front>') }}">
          Tin tức & Blog
        </a>
      </nav>

      <!-- Top Right Actions -->
      <div class="flex items-center space-x-3">
        <button aria-label="Tìm kiếm" class="text-primary hover:text-primary-container transition-colors p-2 rounded-full hover:bg-surface-container">
          <span class="material-symbols-outlined align-middle" style="font-variation-settings: 'FILL' 0;">search</span>
        </button>

        {% if logged_in %}
          <div class="hidden md:flex items-center space-x-2 bg-surface-container px-3 py-1.5 rounded-full border border-outline-variant/30">
            <span class="w-7 h-7 rounded-full bg-primary text-white flex items-center justify-center font-bold text-xs">
              {{ user_name|first|upper }}
            </span>
            <span class="font-body-md text-xs font-semibold text-primary max-w-[100px] truncate">{{ user_name }}</span>
            <a href="{{ user_logout_url|default('/user/logout') }}" class="text-xs text-secondary hover:text-error ml-1 transition-colors" title="Đăng xuất">
              <span class="material-symbols-outlined text-base align-middle">logout</span>
            </a>
          </div>
        {% else %}
          <a class="hidden md:inline-flex items-center justify-center px-6 py-2 bg-primary text-on-primary font-label-md text-label-md rounded-full hover:shadow-[0_0_15px_rgba(0,85,255,0.25)] transition-all" href="/user/login">
            Đăng nhập
          </a>
        {% endif %}

        <!-- Mobile Menu Toggle Button -->
        <button data-vf-mobile-menu-btn class="md:hidden text-primary p-2 focus:outline-none" aria-label="Menu">
          <span class="material-symbols-outlined align-middle text-2xl">menu</span>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div data-vf-mobile-menu class="hidden md:hidden bg-surface-white border-b border-outline-variant/30 px-6 py-4 space-y-3 shadow-lg">
      <a class="block py-2 font-body-md text-primary font-semibold" href="{{ path('<front>') }}">Tin tức & Blog</a>
      {% if logged_in %}
        <div class="pt-2 border-t border-outline-variant/30 space-y-2">
          <a class="block text-center py-2 bg-outline-variant/30 text-secondary font-label-md rounded-full" href="{{ user_logout_url|default('/user/logout') }}">Đăng xuất ({{ user_name }})</a>
        </div>
      {% else %}
        <div class="pt-2 border-t border-outline-variant/30">
          <a class="block text-center py-2 bg-primary text-on-primary font-label-md rounded-full" href="/user/login">Đăng nhập</a>
        </div>
      {% endif %}
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-grow max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop py-10 md:py-16 w-full">
    {{ page.highlighted }}
    {{ page.content }}
  </main>

  <!-- Footer -->
  <footer class="w-full py-section-gap mt-section-gap bg-surface-container-highest dark:bg-surface-dim border-t border-outline-variant/50 transition-all duration-200">
    <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-4 gap-gutter">
      <div class="col-span-1 md:col-span-1 flex flex-col mb-8 md:mb-0">
        <span class="font-headline-lg text-headline-lg font-bold text-primary dark:text-primary-fixed mb-4">VinFast</span>
        <p class="font-body-md text-secondary dark:text-on-secondary-fixed-variant">
          © {{ 'now'|date('Y') }} VinFast Vietnam. Đã đăng ký bản quyền.
        </p>
      </div>
      <div class="col-span-1 md:col-span-3 grid grid-cols-2 md:grid-cols-3 gap-8">
        <div class="flex flex-col space-y-3">
          <h4 class="font-body-md font-semibold text-on-surface mb-2">Về VinFast</h4>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Về chúng tôi</a>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Phát triển bền vững</a>
        </div>
        <div class="flex flex-col space-y-3">
          <h4 class="font-body-md font-semibold text-on-surface mb-2">Thông tin</h4>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Nhà đầu tư</a>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Liên hệ</a>
        </div>
        <div class="flex flex-col space-y-3">
          <h4 class="font-body-md font-semibold text-on-surface mb-2">Pháp lý</h4>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Chính sách bảo mật</a>
          <a class="font-body-md text-secondary hover:text-primary transition-colors" href="#">Điều khoản dịch vụ</a>
        </div>
      </div>
    </div>
  </footer>
</div>
