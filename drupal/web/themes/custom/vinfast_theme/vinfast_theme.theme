<?php

/**
 * @file
 * Functions to support theming in the VinFast theme.
 */

use Drupal\Core\Url;
use Drupal\file\Entity\File;
use Drupal\image\Entity\ImageStyle;
use Drupal\node\Entity\Node;

/**
 * Implements hook_preprocess_html().
 */
function vinfast_theme_preprocess_html(&$variables) {
  $variables['attributes']['class'][] = 'bg-background';
  $variables['attributes']['class'][] = 'text-on-background';
  $variables['attributes']['class'][] = 'font-body-md';
  $variables['attributes']['class'][] = 'antialiased';

  $is_front = \Drupal::service('path.matcher')->isFrontPage();
  $current_path = \Drupal::service('path.current')->getPath();
  $route_name = \Drupal::routeMatch()->getRouteName();

  if ($is_front || $current_path === '/blog') {
    $variables['head_title'] = [
      'title' => 'Tin tức & Blog Xe điện',
      'name' => 'VinFast',
    ];
  }
  elseif ($route_name === 'user.login') {
    $variables['head_title'] = [
      'title' => 'Đăng nhập',
      'name' => 'VinFast',
    ];
  }
  else {
    if (isset($variables['head_title']['name'])) {
      $variables['head_title']['name'] = 'VinFast';
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function vinfast_theme_preprocess_page(&$variables) {
  $variables['site_name'] = \Drupal::config('system.site')->get('name') ?: 'VinFast';
  $variables['base_path'] = base_path();

  // Route & current path detection
  $route_name = \Drupal::routeMatch()->getRouteName();
  $variables['is_login_page'] = in_array($route_name, ['user.login', 'user.pass', 'user.register']);

  // User authentication status
  $current_user = \Drupal::currentUser();
  $variables['logged_in'] = $current_user->isAuthenticated();
  $variables['user_name'] = $current_user->getDisplayName();
  $variables['is_admin_user'] = $current_user->hasPermission('access administration pages');
  if ($variables['logged_in']) {
    $variables['user_logout_url'] = \Drupal\Core\Url::fromRoute('user.logout')->toString();
  }



  if ($variables['is_login_page']) {
    foreach (['vinfast_theme_primary_local_tasks', 'vinfast_theme_local_tasks', 'vinfast_theme_page_title'] as $key) {
      if (isset($variables['page']['highlighted'][$key])) {
        unset($variables['page']['highlighted'][$key]);
      }
      if (isset($variables['page']['content'][$key])) {
        unset($variables['page']['content'][$key]);
      }
    }
  }

  $is_front = \Drupal::service('path.matcher')->isFrontPage();
  $current_path = \Drupal::service('path.current')->getPath();
  $variables['is_blog_page'] = $is_front || ($current_path === '/blog');


  if ($variables['is_blog_page']) {
    if (isset($variables['page']['content']['vinfast_theme_content'])) {
      unset($variables['page']['content']['vinfast_theme_content']);
    }

    $query = \Drupal::entityQuery('node')
      ->condition('type', 'article')

      ->sort('created', 'DESC')
      ->range(0, 12);

    // Khách ngoài chỉ thấy các bài viết Đã xuất bản (status = 1)
    if (!\Drupal::currentUser()->hasPermission('view own unpublished content')) {
      $query->condition('status', 1);
    }
    $query->accessCheck(TRUE);
    $nids = $query->execute();


    $articles = [];
    $hero_article = NULL;
    $curated_images = [
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBy7iEsQJdVm-uhF70vtNkXoF8C9sVOpn27tAex87elmxy2Ms7MuGtDuvQxt3AoH5KtKwelKHgMevvdo8wjGQw_Oc4X-RVtr5nED1qr4B8OvrwGISotXf1vcp5uZgyGbvwesb09cw-58pSPOYBFTpZuIJ2jqMeiz_GGvlwx4dzVFa9YOd20iaOMwMJ9SX59EqKFnvKTPssT7y8OxQpDOYux9e9nTRgJYyAhosT0iEbqbvVVod5y77WnKg',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuAPCET-IRjOCA2UI-VECmXGvTx2Nwx1SF8IFUrHtoeWH1jBxGC4x9aCNZUgDad4vTAAeoWwjJ4Gd1lShRMbLabfjaY2BNMWV8XXNo_Ypnqv_mHQAcorGwAZa6Sb_sTtEE9K8kkZsy3sdDLdRJfQEOX1PmSfuDkU1QA8h889ygbUPOyj1-0Px3w64nnkKKx0gUW9n0wFM3sa0_3geSYdtyx212rG1y1K78xTMv4gFV02XK95_U0YT-JzaA',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBcEt6-RT25yJd6w-wEfBf9PDBj0uZjGoA_egpFD0YcLoriC6nTopDvlccfqdT191wVG6apR3GMotkH7BJ6W8XLZ_R6xnbwl787Efsg57_L3nJ91HmgdHz_LeP9fPv5pMSbXkhDMziSykICvZB4YJSFwgGQIRI-uVNIFtNgtHkI5G2-0i7VW_gSjZ9JMMLn52WyD8AaT5VQFFOXGKhp9Inq194Oj8UmzkLVqy9nmpO1xKgHonGJEQaS5A',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuDhjwHLUy3sx0G-1nj-9A1GK2MXs_2aCwU1Oa__-9WxZG7aWpwNqGgoMLZ6aKOdW45H4GBzCMeQHNRJk5XCGdESV1oouLeUWtJdoDndaGAZF7S9jwASghn5XvRECCeV8vl3br4jL4kaX5VLbLvkkywlxfWwoIkwgTq-ij8CcaIb5sqANpT2JmJk9C2BrcprqYXoSh4L6GN7XHBpz8kBY8aXMt-X5VynfQk3kyGgshphJ75S0ikJKgw2IA',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBa2wZuFxIQqjDtLSOUSaLfJafdj2G2xgYTRTWH4-mtxqJEe7DOSifOytfyCOIftJ0Z4vpgj9mS0oq2-kZkSiBUOFLfEzjvNpmV-rf6ZWcArP1Ss8zh8xRcZReu5uqlxWo1FKsHef3guqgdvHicFKW7KpUoHeGrMyQ79gDa1N4uATA-dqedXiQeK2XgeNhSguXSbmPYRtqCUMai-O5lE2SuTrHpNiMMGTw9E8CI1gnXgCnpvFhMyQOWVw',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuD9-2zReCRwCgiVUf9K-rG5kzY8ntCtk-4BVi8Clg-JXarWbE92jjrMtbI2GbMpY1rU1lKY1nMeZ4Ne7Mqy5Rhtw9Uu-B13CDtGCWTvjQwn2ht6L-a51hmNtS-S7jQnhZT6bvbkujBP0XFZgO7W20N-GG44BlkxrIXhvTEujbV-bMlqJ_LEJ-L6MeOqxdWQrNRIkvSaO45d7XZW1WTpeOt8sx9arOfbNpqiTI3Xr2DpZKcCXqT5gzifdw'
    ];

    // Load dynamic taxonomy tags from Drupal vocabulary 'tags'
    $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('tags');
    $taxonomy_tags = [];
    if (!empty($terms)) {
      foreach ($terms as $term) {
        $taxonomy_tags[] = $term->name;
      }
    }
    if (empty($taxonomy_tags)) {
      $taxonomy_tags = ['Công ty', 'Ô tô điện', 'Xe máy điện'];
    }
    $variables['vf_tags_filter'] = $taxonomy_tags;
    $categories = $taxonomy_tags;
    $idx = 0;

    if (!empty($nids)) {
      $nodes = Node::loadMultiple($nids);
      foreach ($nodes as $node) {
        $img_url = '';
        if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
          $file = File::load($node->get('field_image')->target_id);
          if ($file) {
            $img_url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
          }
        }
        if (!$img_url) {
          $img_url = $curated_images[$idx % count($curated_images)];
        }

        // Tags - Lấy trực tiếp từ trường field_tags của bài viết
        $tags = [];
        if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
          foreach ($node->get('field_tags')->referencedEntities() as $term) {
            $tags[] = $term->label();
          }
        }
        // Nếu bài viết có gắn tag trong Edit -> lấy chính xác tag đó, nếu chưa gán -> để Tin tức
        $category = !empty($tags) ? $tags[0] : 'Tin tức';



        // Date in VN format
        $created_time = $node->getCreatedTime();
        $date_formatted = date('d', $created_time) . ' Tháng ' . date('m', $created_time) . ', ' . date('Y', $created_time);

        // Summary
        $summary = '';
        if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
          $summary = $node->get('body')->summary ?: strip_tags($node->get('body')->value);
          if (mb_strlen($summary) > 160) {
            $summary = mb_substr($summary, 0, 157) . '...';
          }
        }

        $item = [
          'id' => $node->id(),
          'title' => $node->label(),
          'url' => $node->toUrl()->toString(),
          'image' => $img_url,
          'category' => $category,
          'tags' => $tags,
          'date' => $date_formatted,
          'summary' => $summary,
        ];

        if ($idx === 0) {
          $hero_article = $item;
        }
        $articles[] = $item;
        $idx++;
      }
    }

    // Default hero fallback if empty
    if (!$hero_article) {
      $hero_article = [
        'id' => 1,
        'title' => 'Tương lai di chuyển xanh',
        'url' => '#',
        'image' => $curated_images[0],
        'category' => 'Khám Phá',
        'date' => '15 Tháng 05, 2024',
        'summary' => 'VinFast tiên phong định hình kỷ nguyên di chuyển điện hóa tại Việt Nam và trên toàn cầu, mang đến những giải pháp thông minh, bền vững.',
      ];
    }

    $variables['vf_hero_article'] = $hero_article;
    $variables['vf_blog_articles'] = $articles;
  }
}

/**
 * Implements hook_preprocess_node().
 */
function vinfast_theme_preprocess_node(&$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'article') {
    return;
  }

  // Format date in Vietnamese: "15 Tháng 5, 2024"
  $created = $node->getCreatedTime();
  $variables['vf_formatted_date'] = date('d', $created) . ' Tháng ' . date('m', $created) . ', ' . date('Y', $created);

  // Author details
  $author = $node->getOwner();
  $variables['vf_author_name'] = $author ? $author->getDisplayName() : 'Nguyễn Văn A';
  $variables['vf_author_role'] = 'Chuyên gia Ô tô';
  $variables['vf_author_avatar'] = 'https://lh3.googleusercontent.com/aida-public/AB6AXuCKGsX3jZwWansQJRlh8nEMiPzt0Iyd7B7sFeKa367LS5FzdjzoeGAfIN5bAxXtrzHYPEh_YGELzfBTQTeMbv1ysnvuDHkkwiNbrkt7oe574cpUdCwnWISMtO80OiSARY15jPDjoCLZrmk9MAb7RT2R_t8J077t1SO-R4VSRJg6AmNZYP6bs7x_BYD3dJDWDYYE8Rz-sG4PnokxaaXz7tz_qy7K2c0VTDXrqO7UsOH15jLcc0XxcaYrTw';

  // Hero / Featured Image
  $image_url = '';
  if ($node->hasField('field_image') && !$node->get('field_image')->isEmpty()) {
    $file = File::load($node->get('field_image')->target_id);
    if ($file) {
      $image_url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
    }
  }
  if (!$image_url) {
    $image_url = 'https://lh3.googleusercontent.com/aida-public/AB6AXuD9-2zReCRwCgiVUf9K-rG5kzY8ntCtk-4BVi8Clg-JXarWbE92jjrMtbI2GbMpY1rU1lKY1nMeZ4Ne7Mqy5Rhtw9Uu-B13CDtGCWTvjQwn2ht6L-a51hmNtS-S7jQnhZT6bvbkujBP0XFZgO7W20N-GG44BlkxrIXhvTEujbV-bMlqJ_LEJ-L6MeOqxdWQrNRIkvSaO45d7XZW1WTpeOt8sx9arOfbNpqiTI3Xr2DpZKcCXqT5gzifdw';
  }
  $variables['vf_hero_image'] = $image_url;

  // Tags
  $tags = [];
  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    foreach ($node->get('field_tags')->referencedEntities() as $term) {
      $tags[] = $term->label();
    }
  }
  if (empty($tags)) {
    $tags = ['VinFast'];
  }
  $variables['vf_tags'] = $tags;


  // Related Articles for sidebar on full view
  if ($variables['view_mode'] === 'full') {
    $related_query = \Drupal::entityQuery('node')
      ->condition('type', 'article')
      ->condition('nid', $node->id(), '!=')
      ->sort('created', 'DESC')
      ->range(0, 3);

    if (!\Drupal::currentUser()->hasPermission('view own unpublished content')) {
      $related_query->condition('status', 1);
    }
    $related_query->accessCheck(TRUE);
    $related_nids = $related_query->execute();


    $related = [];
    $sample_related_images = [
      'https://lh3.googleusercontent.com/aida-public/AB6AXuBa2wZuFxIQqjDtLSOUSaLfJafdj2G2xgYTRTWH4-mtxqJEe7DOSifOytfyCOIftJ0Z4vpgj9mS0oq2-kZkSiBUOFLfEzjvNpmV-rf6ZWcArP1Ss8zh8xRcZReu5uqlxWo1FKsHef3guqgdvHicFKW7KpUoHeGrMyQ79gDa1N4uATA-dqedXiQeK2XgeNhSguXSbmPYRtqCUMai-O5lE2SuTrHpNiMMGTw9E8CI1gnXgCnpvFhMyQOWVw',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuA5ZjwQFCvPfaDM_iDi_-xcSydCI_-Yyt_AhD6rwQ92UfpGaO-5zRG5Sgmi6CRtn22oJ3skP_CYXDmTJe3saCh8hHD5lQJu_6sFDB1jq_KGRdMCzue0ebqb-gaOSbeGJjMqNOcTMML40IfJEFSPqhKQiBsKwhQ1bpdOTSC1bIMjbpEauHTFtpKKz3awHxIigWL9CB5mjiOqN46S2-cmdpHKKNY-MeCm_dTqOFcOsldeOTYtjhEL7O38GA',
      'https://lh3.googleusercontent.com/aida-public/AB6AXuD49fb0jrL0wU4JSSA4fKONkfns6fOHAfwphvBKVsAQNkC7cpmMzNaG7DDoeHgw5Hepsf8uH1YA6ET2ebFjAC7nJ_E-bYtsGsezx-jyfK9hFLDAMYYVSw7WPb5dbSZ1IMezGbp09Nos3X-ysXooM65_j9xVmvcQrr5HGjdtC6qIillnPNNjhGZH2rpcs6Du3yOsMjZar_q6o_0zKhP7f7mYsxO6XX14-50QID3ISOrhReZ8ZSiZfzJnGw'
    ];

    $i = 0;
    if (!empty($related_nids)) {
      $related_nodes = Node::loadMultiple($related_nids);
      foreach ($related_nodes as $r_node) {
        $r_img = '';
        if ($r_node->hasField('field_image') && !$r_node->get('field_image')->isEmpty()) {
          $f = File::load($r_node->get('field_image')->target_id);
          if ($f) {
            $r_img = \Drupal::service('file_url_generator')->generateString($f->getFileUri());
          }
        }
        if (!$r_img) {
          $r_img = $sample_related_images[$i % count($sample_related_images)];
        }

        $r_created = $r_node->getCreatedTime();
        $r_date = date('d', $r_created) . ' Tháng ' . date('m', $r_created) . ', ' . date('Y', $r_created);

        $related[] = [
          'title' => $r_node->label(),
          'url' => $r_node->toUrl()->toString(),
          'image' => $r_img,
          'date' => $r_date,
        ];
        $i++;
      }
    }

    // Fill with fallback related articles if less than 3
    $fallback_related = [
      [
        'title' => 'Mở Rộng Trạm Sạc: Chìa Khóa Phổ Cập Xe Điện',
        'url' => '#',
        'image' => $sample_related_images[0],
        'date' => '10 Tháng 5, 2024',
      ],
      [
        'title' => 'Công Nghệ ADAS Trên Các Mẫu Xe VinFast Thế Hệ Mới',
        'url' => '#',
        'image' => $sample_related_images[1],
        'date' => '02 Tháng 5, 2024',
      ],
      [
        'title' => 'Vật Liệu Bền Vững Trong Nội Thất Xe Điện Tương Lai',
        'url' => '#',
        'image' => $sample_related_images[2],
        'date' => '25 Tháng 4, 2024',
      ],
    ];

    while (count($related) < 3) {
      $related[] = $fallback_related[count($related)];
    }

    $variables['vf_related_articles'] = $related;
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function vinfast_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $suggestions[] = 'page__front';
  }

  $current_path = \Drupal::service('path.current')->getPath();
  if ($current_path === '/blog') {
    $suggestions[] = 'page__blog';
  }

  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'user.login') {
    $suggestions[] = 'page__user__login';
  }
  elseif ($route_name === 'user.pass') {
    $suggestions[] = 'page__user__password';
  }
  elseif ($route_name === 'user.register') {
    $suggestions[] = 'page__user__register';
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface) {
    $suggestions[] = 'page__node__' . $node->bundle();
  }
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function vinfast_theme_theme_suggestions_node_alter(array &$suggestions, array $variables) {
  $node = $variables['elements']['#node'];
  $view_mode = $variables['elements']['#view_mode'];
  $suggestions[] = 'node__' . $node->bundle() . '__' . $view_mode;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function vinfast_theme_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Username/Email field styling
  $form['name']['#title'] = t('Email hoặc Tên đăng nhập');
  $form['name']['#title_display'] = 'before';
  $form['name']['#attributes']['placeholder'] = 'Nhập email hoặc tên đăng nhập';
  $form['name']['#attributes']['class'] = ['w-full', 'pl-12', 'pr-4', 'py-3', 'bg-surface-container-lowest', 'input-field', 'rounded-lg', 'font-body-md', 'text-on-surface', 'placeholder:text-outline/60'];

  // Password field styling
  $form['pass']['#title'] = t('Mật khẩu');
  $form['pass']['#title_display'] = 'before';
  $form['pass']['#attributes']['placeholder'] = 'Nhập mật khẩu của bạn';
  $form['pass']['#attributes']['class'] = ['w-full', 'pl-12', 'pr-12', 'py-3', 'bg-surface-container-lowest', 'input-field', 'rounded-lg', 'font-body-md', 'text-on-surface', 'placeholder:text-outline/60'];
  $form['pass']['#attributes']['data-vf-password-input'] = 'true';

  // Submit button styling
  $form['actions']['submit']['#value'] = t('Đăng nhập');
  $form['actions']['submit']['#attributes']['class'] = ['w-full', 'flex', 'justify-center', 'py-3', 'px-4', 'rounded-lg', 'font-label-md', 'text-label-md', 'btn-primary', 'uppercase', 'tracking-wide', 'cursor-pointer', 'shadow-md'];
}

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function vinfast_theme_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#form_id']) && $variables['element']['#form_id'] === 'user_login_form') {
    $suggestions[] = 'form__user_login_form';
  }
}








